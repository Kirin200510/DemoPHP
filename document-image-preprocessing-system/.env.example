APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production behind the supplied Nginx TLS proxy:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://documents.example.com
# APP_FORCE_HTTPS=true
# Only set this when a trusted load balancer/reverse proxy is in front of Nginx.
# TRUSTED_PROXIES=10.0.0.10
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true only after TLS is enabled through a trusted local/production proxy.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_ENGINE_URL=http://127.0.0.1:8000
AI_ENGINE_CONNECT_TIMEOUT=5
AI_ENGINE_TIMEOUT=600
AI_ENGINE_BATCH_TIMEOUT=600
AI_ENGINE_RETRY_ATTEMPTS=3
AI_ENGINE_RETRY_DELAY_MILLISECONDS=500
AI_ENGINE_ALERT_WINDOW_MINUTES=15
AI_ENGINE_ALERT_MINIMUM_REQUESTS=5
AI_ENGINE_ALERT_FAILURE_RATIO=0.4
AI_ENGINE_ALERT_COOLDOWN_MINUTES=15

# AI Engine OCR provider: local_hybrid (default), fpt_ai_reader, vnpt_ekyc, or external_ekyc.
OCR_PROVIDER=local_hybrid
# Optional shared absolute path for Laravel and AI Engine on separate mounts.
# AI_OCR_PROVIDER_STATE_PATH=/shared/ocr-provider.json
# FPT.AI Reader sends the documented `image` form field and `api_key` header.
# FPT_AI_READER_API_KEY=
FPT_AI_READER_DOCUMENT_TYPE=id_card
# Leave blank to use FPT's official endpoint for the selected document type.
# FPT_AI_READER_URL=
FPT_AI_READER_TIMEOUT_SECONDS=30
# Generic adapter: only for a vendor returning this application's raw OCR schema.
# EKYC_OCR_URL=
# EKYC_OCR_API_KEY=
EKYC_OCR_TIMEOUT_SECONDS=30
# VNPT eKYC: endpoint and credential are supplied by VNPT for the organization.
# The configured endpoint must return this application's normalized raw OCR schema.
# VNPT_EKYC_OCR_URL=
# VNPT_EKYC_OCR_API_KEY=
VNPT_EKYC_OCR_TIMEOUT_SECONDS=30

DOCUMENT_RETENTION_DAYS=30
DOCUMENT_RETENTION_PURGE_TIME=02:00
